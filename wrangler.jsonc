{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-db",
      "database_id": "cc10c4ab-18e7-403b-b388-45dba9744472",
      "migrations_dir": "migrations"
    }
  ]
}
