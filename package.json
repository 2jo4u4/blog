{
  "name": "jay-huang-cv-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:css": "tailwindcss -i ./src/styles/globals.css -o ./public/styles.css --minify",
    "build": "npm run build:css && wrangler deploy --dry-run --outdir dist",
    "deploy": "npm run build:css && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "prepare": "husky"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@tailwindcss/cli": "^4.0.0",
    "clsx": "^2.1.1",
    "hono": "^4.7.2",
    "marked": "^18.1.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "husky": "^9.1.7",
    "playwright": "^1.64.1",
    "typescript": "^5",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
